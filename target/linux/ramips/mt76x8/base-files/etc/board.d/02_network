. /lib/functions.sh
. /lib/functions/uci-defaults.sh

board_config_update

case "$(board_name)" in
tastek,it692)
	ucidef_add_switch "switch0" \
		"0:lan" "6@eth0"
	ucidef_set_interface "wwan_4g" device "eth1" protocol "dhcp"
	uci -q add_list firewall.@zone[1].network='wwan_4g'
	;;
esac

board_config_flush

exit 0
