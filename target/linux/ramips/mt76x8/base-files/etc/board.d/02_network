. /lib/functions.sh
. /lib/functions/uci-defaults.sh

board_config_update

case "$(board_name)" in
tastek,it692)
	ucidef_add_switch "switch0" \
		"0:lan" "6@eth0"
	ucidef_set_interface "wwan_4g" device "eth1" protocol "dhcp"
	uci -q add_list firewall.@zone[1].network='wwan_4g'
	;;
tastek,it694)
	ucidef_add_switch "switch0" \
		"0:wan" "1:lan" "2:lan" "3:lan" "4:lan" "6@eth0"
	uci -q set network.wan.ipv6='0'
	uci -q set network.wan.delegate='0'
	uci -q delete network.wan6
	uci -q delete network.wwan_4g6
	ucidef_set_interface "wwan_4g" device "usb0" protocol "dhcp"
	uci -q set network.wwan_4g.ipv6='0'
	uci -q set network.wwan_4g.delegate='0'
	uci -q add_list firewall.@zone[1].network='wwan_4g'
	;;
esac

board_config_flush

exit 0
