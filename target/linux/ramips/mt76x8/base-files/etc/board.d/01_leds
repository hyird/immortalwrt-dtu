. /lib/functions/uci-defaults.sh

board_config_update

case "$(board_name)" in
tastek,it692)
	ucidef_set_led_timer "work" "work" "green:status" "500" "500"
	ucidef_set_led_switch "lan" "LAN" "green:wan-online" "switch0" "0x01"
	;;
tastek,it694)
	ucidef_set_led_timer "work" "work" "green:sys" "500" "500"
	ucidef_set_led_netdev "wifi" "wifi" "green:wifi" "wlan0"
	;;
esac

board_config_flush

exit 0
