#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1
EXTRA_COMMANDS="run"

MODEM_GPIO=43
MODEM_PORT=/dev/ttyUSB2

board_supported() {
	[ "$(board_name)" = "tastek,it692" ]
}

modem_power_on() {
	if [ -e /sys/class/gpio/modem_power/value ]; then
		echo 1 > /sys/class/gpio/modem_power/value
		return
	fi

	if [ ! -e "/sys/class/gpio/gpio${MODEM_GPIO}" ]; then
		echo "$MODEM_GPIO" > /sys/class/gpio/export 2>/dev/null
	fi
	echo out > "/sys/class/gpio/gpio${MODEM_GPIO}/direction" 2>/dev/null
	echo 1 > "/sys/class/gpio/gpio${MODEM_GPIO}/value" 2>/dev/null
}

send_at() {
	printf '%s\r' "$1" > "$MODEM_PORT"
	sleep 1
}

modem_start() {
	board_supported || exit 0
	modem_power_on

	# The TAS-682F modem identifies as 3505:0003. Teach the option driver the
	# ID when it is not already in its static table.
	[ -e /sys/bus/usb-serial/drivers/option1/new_id ] && \
		echo '3505 0003' > /sys/bus/usb-serial/drivers/option1/new_id 2>/dev/null

	local timeout=45
	while [ ! -c "$MODEM_PORT" ] && [ "$timeout" -gt 0 ]; do
		sleep 1
		timeout=$((timeout - 1))
	done
	[ -c "$MODEM_PORT" ] || {
		logger -t tas682_4g "modem port $MODEM_PORT not found"
		exit 1
	}

	stty -F "$MODEM_PORT" 115200 raw -echo 2>/dev/null
	send_at 'ATE0'
	send_at 'AT+CGDCONT=1,"IP"'
	send_at 'AT+ECPCFG="usbNet",0'
	send_at 'AT+ECNETDEVCTL=3,1,1'
	send_at 'AT+CFUN=0'
	send_at 'AT+LUIMSLOT=1'
	send_at 'AT+CFUN=1'

	ifup wwan_4g 2>/dev/null
	logger -t tas682_4g 'modem initialized'
}

start_service() {
	board_supported || return 0
	procd_open_instance
	procd_set_param command /etc/init.d/tas682_4g run
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

run() {
	modem_start
}
