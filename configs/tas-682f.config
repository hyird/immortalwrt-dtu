CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y
CONFIG_TARGET_ramips_mt76x8_DEVICE_tastek_it692=y

# TAS-682F has no Wi-Fi radio. Keep only the USB host and modem drivers needed
# by its RNDIS/serial 4G module.
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-serial-option=y

# Minimal LuCI stack for the 8 MiB flash. Select components directly instead
# of the luci/luci-light collections so package management, Wi-Fi and PPP UI
# are not pulled into the image.
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-edgenode=y
CONFIG_LUCI_LANG_zh_Hans=y

# Maintained edge agent and its optional remote terminal capability.
CONFIG_PACKAGE_edgenode=y
CONFIG_PACKAGE_ttyd=y
