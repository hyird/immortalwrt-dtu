CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y
CONFIG_TARGET_ramips_mt76x8_DEVICE_tastek_it692=y

# Keep APK as the build-time package format, but ship no package manager on
# this fixed-purpose appliance.
CONFIG_USE_APK=y
# CONFIG_PACKAGE_apk-openssl is not set
# CONFIG_PACKAGE_apk-mbedtls is not set
# CONFIG_PACKAGE_opkg is not set

# Keep the full router feature set, but omit DNSSEC and its large
# libnettle/libgmp dependency chain.
# CONFIG_PACKAGE_dnsmasq_full_dnssec is not set
# CONFIG_PACKAGE_dnsmasq_full_auth is not set
# CONFIG_PACKAGE_dnsmasq_full_ipset is not set
# CONFIG_PACKAGE_dnsmasq_full_nftset is not set
# CONFIG_PACKAGE_dnsmasq_full_conntrack is not set
# CONFIG_PACKAGE_dnsmasq_full_tftp is not set

# TAS-682F has no Wi-Fi radio. Keep only the USB host and modem drivers needed
# by its RNDIS/serial 4G module.
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-serial-option=y

# Retain LuCI management while avoiding the larger luci collection.
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_luci-base=y
# Keep routing controls in LuCI, but omit the nonessential status and system
# modules bundled by luci-mod-admin-full.
# CONFIG_PACKAGE_luci-mod-admin-full is not set
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-edgenode=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-lib-nixio_notls=y

# EdgeNode uses mbedTLS and provides its remote terminal through its built-in
# PTY bridge, without a separate terminal daemon.
CONFIG_PACKAGE_edgenode=y
# CONFIG_PACKAGE_libopenssl is not set
# CONFIG_PACKAGE_libopenssl3 is not set
# CONFIG_PACKAGE_libustream-openssl is not set

# Field diagnostics requested for this appliance. Telnet is intentionally
# provided by BusyBox and must only be enabled on trusted management networks.
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_TELNET=y
CONFIG_BUSYBOX_CONFIG_TELNETD=y
CONFIG_BUSYBOX_CONFIG_FEATURE_TELNETD_STANDALONE=y
# CONFIG_BUSYBOX_CONFIG_CROND is not set
# CONFIG_BUSYBOX_CONFIG_CRONTAB is not set
# CONFIG_BUSYBOX_CONFIG_MKSWAP is not set
# CONFIG_BUSYBOX_CONFIG_TRACEROUTE6 is not set
CONFIG_PACKAGE_tcpdump-mini=y

# Fixed-purpose kernel: omit unused diagnostics, swap and multicast routing.
# CONFIG_KERNEL_KALLSYMS is not set
# CONFIG_KERNEL_SWAP is not set
# CONFIG_KERNEL_COREDUMP is not set
# CONFIG_KERNEL_ELF_CORE is not set
# CONFIG_KERNEL_CRASHLOG is not set
# CONFIG_KERNEL_DEBUG_FS is not set
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_MAGIC_SYSRQ is not set
# CONFIG_KERNEL_IP_MROUTE is not set
# CONFIG_KERNEL_PRINTK_TIME is not set

# Keep the SSH server, but omit client-side and legacy algorithms.
CONFIG_DROPBEAR_SMALL_CODE=y
CONFIG_DROPBEAR_ED25519=y
# CONFIG_DROPBEAR_DBCLIENT is not set
# CONFIG_DROPBEAR_SCP is not set
# CONFIG_DROPBEAR_ZLIB is not set
# CONFIG_DROPBEAR_AES128 is not set
# CONFIG_DROPBEAR_AES256 is not set
# CONFIG_DROPBEAR_RSA is not set
