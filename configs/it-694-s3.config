# IT-694_s3 release seed, derived from the TAS-682F appliance baseline.
# Use this file for the Wi-Fi/4G IT-694 image; use tas-682f.config for IT-692.
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y
CONFIG_TARGET_ramips_mt76x8_DEVICE_tastek_it694=y

# Keep APK as the build-time package format, but ship no package manager on
# this fixed-purpose appliance.
CONFIG_USE_APK=y
CONFIG_CLEAN_APK=y
# CONFIG_PACKAGE_apk-openssl is not set
# apk-mbedtls is required by the build system for package-index generation;
# the device package list excludes it from the fixed-purpose image.
CONFIG_PACKAGE_apk-mbedtls=y
# CONFIG_PACKAGE_opkg is not set

# Keep the full router feature set, but omit DNSSEC and its large
# libnettle/libgmp dependency chain.
# CONFIG_PACKAGE_dnsmasq_full_auth is not set
# CONFIG_PACKAGE_dnsmasq_full_tftp is not set

# IT-694_s3 has an onboard MT7603 2.4 GHz radio and a USB RNDIS/serial 4G
# modem. The Wi-Fi calibration data is read from the factory partition by the
# device tree, while the RNDIS interface is exposed as usb0.
CONFIG_PACKAGE_kmod-mt7603=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-serial-option=y

# Use the standard light router administration set, including native
# WireGuard protocol support for the EdgeNode VPN interface.
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-app-edgenode=y
CONFIG_PACKAGE_luci-app-4ginfo=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-lib-nixio_notls=y

# EdgeNode uses mbedTLS and provides its remote terminal through its built-in
# PTY bridge, without a separate terminal daemon.
CONFIG_PACKAGE_edgenode=y
# EdgeNode's VPN data plane uses the kernel WireGuard module and the
# existing firewall4-compatible nftables userspace tool.
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_ca-bundle=y

# Provide SSH file-transfer tools for field maintenance. BusyBox supplies tar,
# Dropbear supplies the SSH client and scp, and OpenSSH supplies the SFTP
# client/server implementation used by Dropbear.
CONFIG_BUSYBOX_CONFIG_TAR=y
CONFIG_DROPBEAR_DBCLIENT=y
CONFIG_DROPBEAR_SCP=y
CONFIG_DROPBEAR_SFTPSERVER=y
CONFIG_PACKAGE_openssh-sftp-client=y
CONFIG_PACKAGE_openssh-sftp-server=y
# CONFIG_PACKAGE_libopenssl is not set
# CONFIG_PACKAGE_libopenssl3 is not set
# CONFIG_PACKAGE_libustream-openssl is not set

# EdgeNode is an HTTPS client. Retain interoperable TLS 1.2 ECDHE with RSA or
# ECDSA certificates and AES-GCM, while omitting Wi-Fi/PSK legacy algorithms,
# uncommon curves and the larger TLS 1.3 PSA stack.
# CONFIG_MBEDTLS_CMAC_C is not set
# CONFIG_MBEDTLS_DES_C is not set
# CONFIG_MBEDTLS_NIST_KW_C is not set
# CONFIG_MBEDTLS_KEY_EXCHANGE_PSK_ENABLED is not set
# CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_PSK_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED is not set
# CONFIG_MBEDTLS_SSL_PROTO_TLS1_3 is not set

# Field diagnostics requested for this appliance. Telnet is intentionally
# provided by BusyBox and must only be enabled on trusted management networks.
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_TELNET=y
CONFIG_BUSYBOX_CONFIG_TELNETD=y
CONFIG_BUSYBOX_CONFIG_FEATURE_TELNETD_STANDALONE=y
# CONFIG_BUSYBOX_CONFIG_CROND is not set
# CONFIG_BUSYBOX_CONFIG_CRONTAB is not set
# CONFIG_BUSYBOX_CONFIG_MKSWAP is not set
# CONFIG_BUSYBOX_CONFIG_TRACEROUTE6 is not set
CONFIG_PACKAGE_tcpdump-mini=y

# Fixed-purpose kernel: omit unused diagnostics, swap and multicast routing.
# CONFIG_KERNEL_KALLSYMS is not set
# CONFIG_KERNEL_SWAP is not set
# CONFIG_KERNEL_COREDUMP is not set
# CONFIG_KERNEL_ELF_CORE is not set
# CONFIG_KERNEL_CRASHLOG is not set
# CONFIG_KERNEL_DEBUG_FS is not set
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_MAGIC_SYSRQ is not set
# CONFIG_KERNEL_CRASH_DUMP is not set
# CONFIG_KERNEL_IP_MROUTE is not set
# CONFIG_KERNEL_PRINTK_TIME is not set

# Keep the SSH server, but omit client-side and legacy algorithms.
CONFIG_DROPBEAR_SMALL_CODE=y
CONFIG_DROPBEAR_ED25519=y
# CONFIG_DROPBEAR_ZLIB is not set
# CONFIG_DROPBEAR_AES128 is not set
# CONFIG_DROPBEAR_AES256 is not set
# CONFIG_DROPBEAR_RSA is not set
