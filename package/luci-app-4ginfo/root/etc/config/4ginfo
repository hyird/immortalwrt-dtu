config modem 'modem'
	option enabled '0'
	option at_port '/dev/ttyUSB2'
	option at_profile 'generic'
	option network_interface 'usb0'
	option power_control 'none'
	option power_path '/sys/class/gpio/modem_power/value'
	option monitor_interval '30'
	option automatic_apn '1'
	option apn ''
	option pdp_type 'ipv4'
	option auth_type 'none'
	option username ''
	option password ''
	option pin_code ''
