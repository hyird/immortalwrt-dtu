#!/bin/sh /etc/rc.common

USE_PROCD=1
START=94
STOP=11

start_service() {
	local at_port monitor_interval enabled power_control power_path

	config_load 4ginfo
	config_get_bool enabled modem enabled 0
	[ "$enabled" -gt 0 ] || return 0
	config_get at_port modem at_port '/dev/ttyUSB2'
	config_get monitor_interval modem monitor_interval '30'
	config_get power_control modem power_control 'none'
	config_get power_path modem power_path '/sys/class/gpio/modem_power/value'

	if [ "$power_control" = 'gpio' ]; then
		/usr/sbin/4ginfo-modem-power --on "$power_path" >/dev/null 2>&1 || true
		procd_open_instance modem_power
		procd_set_param command /usr/sbin/4ginfo-modem-power --watch "$at_port" "$power_path"
		procd_set_param respawn 3600 5 -1
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi

	procd_open_instance monitor
	procd_set_param command /usr/sbin/4ginfo-modemctl monitor "$monitor_interval"
	procd_set_param respawn 3600 5 -1
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	local enabled power_control power_path

	config_load 4ginfo
	config_get_bool enabled modem enabled 0
	config_get power_control modem power_control 'none'
	config_get power_path modem power_path '/sys/class/gpio/modem_power/value'
	[ "$enabled" -gt 0 ] && [ "$power_control" = 'gpio' ] || return 0
	/usr/sbin/4ginfo-modem-power --off "$power_path" >/dev/null 2>&1 || true
}
