#!/bin/sh

[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = 'tastek,it694' ] || exit 0

changed=0

set_if_needed() {
	local current
	current="$(uci -q get "$1" 2>/dev/null)"
	[ "$current" = "$2" ] && return 0
	uci -q set "$1=$2"
	changed=1
}

# /etc/config/edgenode is a conffile, so correct existing upgrades as well as
# fresh images without overwriting unrelated user platform settings.
set_if_needed edgenode.modem.usb_vendor 1286
set_if_needed edgenode.modem.usb_product 4e3c
set_if_needed edgenode.modem.at_port /dev/ttyUSB2

# Keep the dedicated 4G data path IPv4-only. The physical Ethernet WAN remains
# the same port, but is also explicitly IPv4-only and has no wan6 interface.
if [ -e /etc/config/network ]; then
	set_if_needed network.wan.ipv6 0
	set_if_needed network.wan.delegate 0
	set_if_needed network.wwan_4g.ipv6 0
	set_if_needed network.wwan_4g.delegate 0
	uci -q delete network.wan6
fi

[ "$changed" -eq 0 ] || uci -q commit edgenode
[ -e /etc/config/network ] && uci -q commit network

exit 0
