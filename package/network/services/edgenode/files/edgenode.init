#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

# A restart may be invoked from a PTY hosted by the main EdgeNode process.
# Stopping that process closes the PTY and sends SIGHUP to this shell, so keep
# the init command alive until the new procd instances have been registered.
restart() {
	trap '' HUP TERM
	stop "$@"
	start "$@"
	trap - HUP TERM
}

initialize_model() {
	local configured detected

	config_get configured node model
	[ -r /tmp/sysinfo/model ] && detected="$(cat /tmp/sysinfo/model)"
	[ -n "$detected" ] || return 0
	[ "$configured" = "$detected" ] && return 0
	uci -q set edgenode.node.model="$detected" && uci -q commit edgenode
}

start_service() {
	local at_port status_path monitor_interval wan_interface board

	config_load edgenode
	initialize_model
	config_get at_port modem at_port
	config_get status_path modem status_path '/tmp/edgenode/modem.status'
	config_get monitor_interval modem monitor_interval '30'
	config_get wan_interface hardware wan_interface 'eth1'

	board="$(cat /tmp/sysinfo/board_name 2>/dev/null)"
	if [ "$board" = 'tastek,it694' ]; then
		/usr/sbin/edgenode-modem-power --on >/dev/null 2>&1 || true
	fi

	if [ -e "$at_port" ]; then
		/usr/sbin/edgenode --initialize-modem "$at_port" "$status_path" "$wan_interface" \
			>/dev/null 2>&1 || \
			logger -t edgenode 'modem identity is not available yet; monitor will retry'
	else
		logger -t edgenode "modem AT port $at_port is not available yet"
	fi

	if [ "$board" = 'tastek,it694' ]; then
		procd_open_instance modem_power
		procd_set_param command /usr/sbin/edgenode-modem-power --watch "$at_port"
		procd_set_param respawn 3600 5 -1
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi

	procd_open_instance modem
	procd_set_param command /usr/sbin/edgenode --monitor-modem \
		"$at_port" "$status_path" "$wan_interface" "$monitor_interval"
	procd_set_param respawn 3600 5 -1
	procd_set_param limits core="0 0"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance main
	procd_set_param command /usr/sbin/edgenode-start
	procd_set_param respawn 3600 5 -1
	procd_set_param limits core="0 0"
	procd_set_param file /etc/config/edgenode
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = 'tastek,it694' ] || return 0
	/usr/sbin/edgenode-modem-power --off >/dev/null 2>&1 || true
}

reload_service() {
	procd_send_signal edgenode '*' HUP
}

service_triggers() {
	procd_add_reload_trigger edgenode
}
