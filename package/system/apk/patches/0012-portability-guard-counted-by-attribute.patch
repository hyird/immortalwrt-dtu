GCC versions without counted_by warn for every translation unit including
apk_database.h. Keep the hardening annotation when the compiler supports it,
while retaining the same structure layout on older toolchains.

---
 src/apk_database.h | 9 +++++++++
 1 file changed, 9 insertions(+)

--- a/src/apk_database.h
+++ b/src/apk_database.h
@@ -24,6 +24,15 @@ APK_ARRAY(apk_name_array, struct apk_name *);
 int apk_name_array_qsort(const void *a, const void *b);
 
+#if defined(__has_attribute)
+# if __has_attribute(counted_by)
+#  define APK_COUNTED_BY(member) __attribute__((counted_by(member)))
+# endif
+#endif
+#ifndef APK_COUNTED_BY
+# define APK_COUNTED_BY(member)
+#endif
+
 struct apk_db_acl {
 	mode_t mode;
 	uid_t uid;
 	gid_t gid;
 	uint8_t xattr_hash_len;
-	uint8_t xattr_hash[] __attribute__((counted_by(xattr_hash_len)));
+	uint8_t xattr_hash[] APK_COUNTED_BY(xattr_hash_len);
 } __attribute__((packed));
 
 static inline apk_blob_t apk_acl_digest_blob(struct apk_db_acl *acl) {
